{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/ai/copilot",
      "destination": "/api/copilot"
    },
    {
      "source": "/api/ai/analyze-crop",
      "destination": "/api/analyze-crop"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}